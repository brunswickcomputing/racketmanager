{
  "name": "racketmanager/racketmanager",
  "description": "RacketManager WordPress plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.4",
    "ext-intl": "*",
    "stripe/stripe-php": "^16.4.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpunit/phpunit": "^13.4",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "files": [
      "src/php/aliases.php"
    ],
    "psr-4": {
      "Racketmanager\\": "src/php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Racketmanager\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
