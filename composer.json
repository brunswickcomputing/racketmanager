{
  "name": "racketmanager/racketmanager",
  "description": "RacketManager WordPress plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.4",
    "ext-intl": "*",
    "stripe/stripe-php": "^16.4.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpunit/phpunit": "^13.4.6",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload": {
    "psr-4": {
      "Racketmanager\\": "src/php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Racketmanager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpcs": "phpcs -p",
    "phpcbf": "phpcbf",
    "test": "vendor/bin/phpunit",
    "test:coverage": "vendor/bin/phpunit --coverage-text --coverage-clover build/logs/clover.xml --coverage-html build/coverage"
  },
  "scripts-descriptions": {
    "test": "Run the test suite",
    "test:coverage": "Run the test suite with code coverage (requires PCOV or Xdebug extension)"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
