<?xml version="1.0"?>
<ruleset name="RacketManager WordPress Coding Standards">
	<description>PHPCS ruleset for RacketManager WordPress plugin.</description>

	<!-- Scan all PHP files in plugin -->
	<file>./</file>

	<!-- Exclude third-party, build, and generated directories -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/.github/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>
	<exclude-pattern>*/coverage/*</exclude-pattern>
	<exclude-pattern>*/.phpunit.cache/*</exclude-pattern>
	<exclude-pattern>*/qodana*.yaml</exclude-pattern>

	<!-- Arguments: show sniff codes, colors, parallel, cache -->
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>

	<!-- Configuration: WordPress and PHP versions -->
	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="8.4-"/>
	<config name="text_domain" value="racketmanager"/>

	<!-- Enforce full WordPress Coding Standards -->
	<rule ref="WordPress">
		<exclude name="WordPress.WP.DeprecatedFunctions.sanitize_urlFound"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.PHP.StrictInArray.FoundNonStrictFalse"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.matchFound"/>
	</rule>

	<!-- Whitelist global prefix -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="racketmanager"/>
			</property>
		</properties>
	</rule>

	<!-- Whitelist custom plugin capabilities -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="racket_manager"/>
				<element value="manage_racketmanager"/>
				<element value="racketmanager_settings"/>
				<element value="update_results"/>
				<element value="del_teams"/>
				<element value="edit_teams"/>
				<element value="del_leagues"/>
				<element value="edit_leagues"/>
				<element value="edit_league_settings"/>
				<element value="view_leagues"/>
				<element value="import_leagues"/>
				<element value="del_seasons"/>
				<element value="edit_seasons"/>
				<element value="del_matches"/>
				<element value="edit_matches"/>
			</property>
		</properties>
	</rule>
</ruleset>
