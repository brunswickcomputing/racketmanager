<?xml version="1.0"?>
<ruleset name="RacketManager WordPress Coding Standards">
	<description>PHPCS ruleset for RacketManager WordPress plugin.</description>

	<!-- Scan all PHP files in plugin -->
	<file>./</file>

	<!-- Exclude third-party, build, and generated directories -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/.github/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>
	<exclude-pattern>*/coverage/*</exclude-pattern>
	<exclude-pattern>*/.phpunit.cache/*</exclude-pattern>
	<exclude-pattern>*/qodana*.yaml</exclude-pattern>

	<!-- Exclude front-end assets by extension. Patterns are regexes: escape the dot and anchor
	     with $ so that e.g. "*.js" does not also match PHP files named Json_*.php.
	     Needed because <arg name="extensions"> is overridden by any CLI "extensions" flag (IDE, hooks). -->
	<exclude-pattern>*\.js$</exclude-pattern>
	<exclude-pattern>*\.mjs$</exclude-pattern>
	<exclude-pattern>*\.cjs$</exclude-pattern>
	<exclude-pattern>*\.jsx$</exclude-pattern>
	<exclude-pattern>*\.ts$</exclude-pattern>
	<exclude-pattern>*\.tsx$</exclude-pattern>
	<exclude-pattern>*\.css$</exclude-pattern>
	<exclude-pattern>*\.scss$</exclude-pattern>

	<!-- Arguments: show sniff codes, colors, parallel, cache -->
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>

	<!-- Configuration: WordPress and PHP versions -->
	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="8.4-"/>
	<config name="text_domain" value="racketmanager"/>

	<!-- Base ruleset: WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Core exclusions for existing plugin architecture -->
		<exclude name="WordPress.WP.DeprecatedFunctions.sanitize_urlFound"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.PHP.StrictInArray.FoundNonStrictFalse"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.matchFound"/>

		<!-- 1. Indentation: plugin uses 4 spaces instead of tabs -->
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="Universal.WhiteSpace.PrecisionAlignment"/>

		<!-- 2. Array syntax: plugin uses short arrays [] instead of long array() -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

		<!-- 3. File and class naming: PSR-4 conventions (e.g. League.php, not class-league.php) -->
		<exclude name="WordPress.Files.FileName"/>

		<!-- 4. Modern PHP strict typing: declare(strict_types=1) at top of file -->
		<exclude name="PSR12.Files.FileHeader.IncorrectOrder"/>

		<!-- 5. PHP 8.4 syntax compatibility (property hooks, etc.) -->
		<exclude name="Squiz.PHP.NonExecutableCode.Unreachable"/>
		<exclude name="PSR2.Classes.PropertyDeclaration.Multiple"/>
		<exclude name="PSR2.Classes.PropertyDeclaration.ScopeMissing"/>

		<!-- 6. Allow short ternary ?: -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>

		<!-- 7. Namespace case sensitivity (e.g. Racketmanager\Infrastructure\Wordpress) -->
		<exclude name="WordPress.WP.CapitalPDangit.MisspelledNamespaceName"/>

		<!-- 8. Allow docblocks without a short description -->
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>

	<!-- Configure 4-space indentation across control structures, scopes, and arrays -->
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="4"/>
			<property name="tabIndent" value="false"/>
			<property name="exact" value="false"/>
			<property name="ignoreIndentationTokens" type="array">
				<element value="T_HEREDOC"/>
				<element value="T_NOWDOC"/>
				<element value="T_INLINE_HTML"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.Arrays.ArrayIndentation">
		<properties>
			<property name="tabIndent" value="false"/>
		</properties>
	</rule>

	<!-- Whitelist global prefix -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="racketmanager"/>
			</property>
		</properties>
	</rule>

	<!-- Whitelist custom plugin capabilities -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="racket_manager"/>
				<element value="manage_racketmanager"/>
				<element value="racketmanager_settings"/>
				<element value="update_results"/>
				<element value="del_teams"/>
				<element value="edit_teams"/>
				<element value="del_leagues"/>
				<element value="edit_leagues"/>
				<element value="edit_league_settings"/>
				<element value="view_leagues"/>
				<element value="import_leagues"/>
				<element value="del_seasons"/>
				<element value="edit_seasons"/>
				<element value="del_matches"/>
				<element value="edit_matches"/>
			</property>
		</properties>
	</rule>
	<!-- Test directory exclusions: omit strict docblock requirements, global prefixes, and high-churn array/alignment formatting -->
	<!-- Explicit sniff list (mirrors the Squiz.Commenting sniffs WordPress enables). A category reference would also pull in LongConditionClosingComment and PostStatementComment. -->
	<rule ref="Squiz.Commenting.BlockComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClosingDeclarationComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.DocCommentAlignment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.EmptyCatchComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionCommentThrowTag">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.InlineComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Arrays.MultipleStatementAlignment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Formatting.MultipleStatementAlignment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
    <!-- Allow missing file doc comment everywhere (file headers are optional in this plugin).
         Declared as a standalone severity override so it is independent of any <rule ref> above. -->
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <severity>0</severity>
    </rule>
</ruleset>
